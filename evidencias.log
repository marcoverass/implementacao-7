#define _GNU_SOURCE
#include <linux/filter.h>
#include <linux/seccomp.h>
#include <sys/prctl.h>
#include <sys/syscall.h>
#include <stddef.h>
#include <stdio.h>
#include <unistd.h>
#define DENY(n) BPF_JUMP(BPF_JMP|BPF_JEQ|BPF_K, __NR_##n, 0, 1), BPF_STMT(BPF_RET|BPF_K, SECCOMP_RET_KILL_PROCESS)
__attribute__((constructor)) static void restrict_calls(void) {
    struct sock_filter filter[] = {
        BPF_STMT(BPF_LD|BPF_W|BPF_ABS, offsetof(struct seccomp_data,nr)),
        DENY(clone3), DENY(rseq), DENY(set_robust_list), DENY(madvise),
        DENY(rename), DENY(renameat), DENY(renameat2), DENY(unlink), DENY(unlinkat),
        DENY(newfstatat), DENY(fstat), DENY(futex),
        BPF_STMT(BPF_RET|BPF_K, SECCOMP_RET_ALLOW)
    };
    struct sock_fprog prog={sizeof(filter)/sizeof(filter[0]),filter};
    if (prctl(PR_SET_NO_NEW_PRIVS,1,0,0,0) || prctl(PR_SET_SECCOMP,SECCOMP_MODE_FILTER,&prog)) {
        perror("filtro de teste"); _exit(90);
    }
}
